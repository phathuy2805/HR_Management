// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  HR_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveType {
  SICK
  CASUAL
  VACATION
}

enum LeaveStatus {
  PENDING
  APPROVED_BY_MANAGER
  APPROVED_BY_HR
  REJECTED
}

enum PayrollStatus {
  PENDING
  PAID
}

model Department {
  id         Int        @id @default(autoincrement())
  name       String     @unique @db.VarChar(100)
  budget     Decimal?   @db.Decimal(12, 2)
  location   String     @db.VarChar(150)
  created_at DateTime   @default(now())
  employees  Employee[]

  @@map("departments")
}

model JobTitle {
  id               Int      @id @default(autoincrement())
  title            String   @unique @db.VarChar(100)
  salary_range_min Decimal? @db.Decimal(10, 2)
  salary_range_max Decimal? @db.Decimal(10, 2)

  employees Employee[]

  @@map("job_titles")
}

model Employee {
  id            Int            @id @default(autoincrement())
  first_name    String         @db.VarChar(50)
  last_name     String         @db.VarChar(50)
  email         String         @unique @db.VarChar(150)
  password      String         @db.VarChar(255)
  role          Role           @default(USER)
  department_id Int?
  job_title_id  Int?
  manager_id    Int?
  status        EmployeeStatus @default(ACTIVE)
  created_at    DateTime       @default(now()) @map("created_at")

  department Department? @relation(fields: [department_id], references: [id], onDelete: Restrict)
  manager    Employee?   @relation("ManagerStaff", fields: [manager_id], references: [id], onDelete: SetNull)
  staff      Employee[]  @relation("ManagerStaff")
  job_title  JobTitle?   @relation(fields: [job_title_id], references: [id], onDelete: Restrict)

  leave_requests          LeaveRequest[] @relation("EmployeeLeaveRequests")
  managed_leave_approvals LeaveRequest[] @relation("ManagerLeaveApprovals")
  hr_leave_approvals      LeaveRequest[] @relation("HrLeaveApprovals")
  payrolls                Payroll[]

  @@map("employees")
}

model LeaveRequest {
  id                     Int         @id @default(autoincrement())
  employee_id            Int
  start_date             DateTime    @db.Date
  end_date               DateTime    @db.Date
  type                   LeaveType   @default(CASUAL)
  status                 LeaveStatus @default(PENDING)
  reason                 String?     @db.Text
  approved_by_manager_id Int?
  approved_by_hr_id      Int?

  employee            Employee  @relation("EmployeeLeaveRequests", fields: [employee_id], references: [id], onDelete: Cascade)
  approved_by_manager Employee? @relation("ManagerLeaveApprovals", fields: [approved_by_manager_id], references: [id], onDelete: SetNull)
  approved_by_hr      Employee? @relation("HrLeaveApprovals", fields: [approved_by_hr_id], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

model Payroll {
  id               Int           @id @default(autoincrement())
  employee_id      Int
  base_salary      Decimal       @db.Decimal(10, 2)
  bonuses          Decimal       @default(0) @db.Decimal(10, 2)
  deductions       Decimal       @default(0) @db.Decimal(10, 2)
  total_salary     Decimal?      @default(dbgenerated()) @db.Decimal(10, 2)
  pay_period_start DateTime      @db.Date
  pay_period_end   DateTime      @db.Date
  status           PayrollStatus @default(PENDING)
  created_at       DateTime      @default(now()) @map("created_at")

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("payrolls")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actor_id   Int?     @map("actor_id")
  action     String   @db.VarChar(20)
  table_name String   @db.VarChar(50)
  record_id  Int
  old_value  Json?    @db.JsonB
  new_value  Json?    @db.JsonB
  ip_address String?  @db.VarChar(45)
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}
